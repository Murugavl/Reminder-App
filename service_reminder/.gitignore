# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing — never commit your keystore or its credentials.
/android/key.properties
*.jks
*.keystore

# Flutter build logs (generated during flutter run/build)
flutter_*.log

# Android machine-local SDK/Flutter paths — every developer has different
# local installations; this is auto-generated by the Flutter tooling.
android/local.properties

# Google Sign-In / Firebase OAuth client config.
# This file contains your project's OAuth client ID and is tied to your
# signing certificate — never commit it. See README.md "Google Sign-In setup".
android/app/google-services.json

# Environment / secrets files
.env
.env.*
# Keep the example template so contributors know what to provide.
!.env.example
